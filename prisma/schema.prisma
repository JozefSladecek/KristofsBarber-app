// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  name            String
  username        String           @unique
  password        String
  role            Role             @default(EMPLOYEE)
  entries         Entry[]
  envelopePayouts EnvelopePayout[]
  sales           Sale[]           @relation("UserSales")
}

enum Role {
  EMPLOYEE
  ADMIN
  OWNER
}

model Entry {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  clients      Int
  cash         Float
  card         Float
  envelopeCash Float?
  note         String?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([userId, date])
}

model EnvelopePayout {
  id     String   @id @default(cuid())
  month  DateTime @db.Date
  amount Float
  paidAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([userId, month])
}

model Product {
  id                String          @id @default(cuid())
  name              String
  category          ProductCategory
  price             Float
  stock             Int
  lowStockThreshold Int             @default(3)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  saleItems         SaleItem[]

  @@unique([name])
}

enum ProductCategory {
  PRODUCT
  DRINK
}

model Sale {
  id            String        @id @default(cuid())
  date          DateTime      @db.Date
  paymentMethod PaymentMethod
  note          String?
  createdAt     DateTime      @default(now())

  user   User   @relation("UserSales", fields: [userId], references: [id])
  userId String

  items SaleItem[]
}

model SaleItem {
  id String @id @default(cuid())

  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  // Snapshot of the product's name and price at the time of the sale.
  // Kept here so later changes in the catalog don't rewrite past sales.
  productName  String
  pricePerUnit Float

  quantity Int

  @@unique([saleId, productId])
}

enum PaymentMethod {
  CASH
  CARD
}
